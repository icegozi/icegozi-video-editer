# Video Pipeline Default Configuration
VIDEO_DEFAULT_WIDTH=1920
VIDEO_DEFAULT_HEIGHT=1080
VIDEO_DEFAULT_FPS=30

# Optional custom FFmpeg/FFprobe binary paths (auto-detected if omitted)
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe

# Local desktop runtime overrides (normally set by the packaged launcher)
# ICEGOZI_PORT=3200
# ICEGOZI_DATA_DIR=C:\path\to\icegozi-workspace
# ICEGOZI_APP_ROOT=C:\path\to\installed-icegozi-video
# ICEGOZI_DB_PATH=C:\path\to\icegozi-workspace\data\icegozi.sqlite
# ICEGOZI_BROWSER_EXECUTABLE=C:\path\to\browser.exe
# ICEGOZI_OPEN_BROWSER=1

# Log Level: debug | info | warn | error
LOG_LEVEL=info
