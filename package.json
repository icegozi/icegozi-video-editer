{
  "name": "icegozi_video",
  "version": "1.0.0",
  "description": "AI-assisted programmable video editing system based on Remotion and FFmpeg",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3200",
    "build:editor": "vite build",
    "render": "tsx scripts/render-preview.ts --profile final",
    "render:preview": "tsx scripts/render-preview.ts --profile preview",
    "render:direct": "remotion render src/index.ts MainVideo output/main_video.mp4",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:siwc",
    "test:siwc": "node --import tsx --test tests/siwc-devkit/*.check.mjs",
    "test:assistant-ui": "tsx tests/e2e/assistant-ui.check.ts",
    "codex:protocol": "tsx scripts/generate-codex-protocol.ts",
    "codex:check": "tsx scripts/check-codex-runtime.ts",
    "test:watch": "vitest",
    "media:inspect": "tsx scripts/inspect-media.ts",
    "media:validate": "tsx scripts/validate-assets.ts",
    "media:normalize": "tsx scripts/normalize-media.ts",
    "clean:generated": "tsx scripts/clean-generated.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "@openai/codex": "0.160.1",
    "@remotion/captions": "^4.0.260",
    "@remotion/media-utils": "^4.0.260",
    "@remotion/player": "^4.0.534",
    "@remotion/transitions": "^4.0.260",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "6.2.12",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "openai": "7.31.0",
    "proper-lockfile": "4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.260",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@remotion/cli": "^4.0.260",
    "@types/better-sqlite3": "^9.6.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.13.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.4",
    "vitest": "^3.0.5"
  }
}
